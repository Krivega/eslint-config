{
  "name": "@krivega/eslint-config",
  "version": "1.1.26",
  "bugs": {
    "url": "https://github.com/Krivega/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krivega/eslint-config.git"
  },
  "license": "MIT",
  "author": {
    "name": "Krivega Dmitriy",
    "email": "mr.krivega@gmail.com",
    "url": "https://krivega.com"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./react": "./react.js",
    "./jest": "./jest.js",
    "./vitest": "./vitest.js",
    "./cypress": "./cypress.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.json",
    "lint": "yarn build && yarn lint:src && yarn lint:examples",
    "lint:examples": "yarn --cwd ./example lint && yarn --cwd ./exampleReact lint && yarn --cwd ./exampleVitest lint",
    "lint:src": "yarn lint:ts",
    "lint:ts": "node ./node_modules/@typescript/native/bin/tsc --noEmit --project tsconfig.json",
    "prepublishOnly": "yarn build",
    "release": "release-it --only-version",
    "run:postinstall": "yarn --cwd ./example install && yarn --cwd ./exampleReact install && yarn --cwd ./exampleVitest install",
    "test": "yarn build && node --test tests/*.test.mjs && yarn --cwd ./exampleVitest test"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.30.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-cypress": "^7.0.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "^3.10.1",
    "release-it": "^21.1.2"
  },
  "peerDependencies": {
    "eslint": "10.15.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.0.0"
  }
}
